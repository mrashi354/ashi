{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/brdm-school",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200
    }
  ],
  "env": {
    "VITE_API_URL": "@vite-api-url",
    "VITE_BASE_URL": "@vite-base-url"
  }
}
