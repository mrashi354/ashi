# BRDM Public School Website - Example Environment Variables
# Copy this file to .env and fill in your real keys.

# ---------- Server ----------
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=info
BASE_PATH=/
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ---------- Frontend ----------
# API server ka URL (localhost / Vercel / Render domain)
VITE_API_URL=http://localhost:3001

# ---------- AI Chat (Groq) ----------
# /api/ai/chat ke liye (artifacts/api-server/src/routes/ai.ts)
GROQ_API_KEY=

# ---------- Email (Resend) ----------
# Contact & Admissions forms ke liye (artifacts/api-server/src/routes/contact.ts, admissions.ts)
RESEND_API_KEY=

# ---------- Email (Brevo) backup ----------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=mrashi354@gmail.com
BREVO_SENDER_NAME=BRDM Public School

# ---------- Database ----------
DATABASE_URL=

# ---------- OpenAI ----------
OPENAI_API_KEY=

# ---------- OpenAI AI Integration (lib/integrations) ----------
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=