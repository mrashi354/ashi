# Backend (API Server) Production Environment Variables
# Set these on Render in the environment variables section

PORT=3001

NODE_ENV=production

# CORS - Production Vercel domain (replace with actual Vercel domain)
CORS_ORIGIN=https://your-site.vercel.app,https://your-site-production.vercel.app

# OpenAI Configuration
OPENAI_API_KEY=sk-your-production-key

# Database URLs
DATABASE_URL=your-production-database-url

# Email/Resend Configuration
RESEND_API_KEY=your-production-resend-key
