# Backend (API Server) Environment Variables

# Server port
PORT=3001

# Environment
NODE_ENV=development

# CORS - Allowed origins (comma-separated for multiple)
# Local development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://0.0.0.0:3000

# OpenAI Configuration (if using AI features)
OPENAI_API_KEY=sk-your-key-here

# Database URLs (if using database)
DATABASE_URL=

# Email/Resend Configuration (if using email)
RESEND_API_KEY=
